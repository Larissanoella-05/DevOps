# Dependencies
node_modules/

# Husky's internal shim directory — regenerated by `npm install`
# (via the "prepare" script), only .husky/pre-commit itself is committed
.husky/_

# Database (auto-generated at runtime)
Backend/agripulse.db
Backend/agripulse.db-shm
Backend/agripulse.db-wal

# Environment & secrets
.env
.env.local
.env.production
*.env

# IDE files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS files
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
dist/
build/
.cache/

# Testing
coverage/
.nyc_output/

# Terraform
# State can hold sensitive values — never commit it.
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# terraform.tfvars is kept on purpose — it holds no secrets (see terraform/README.md).
